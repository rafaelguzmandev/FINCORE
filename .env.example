
# PostgreSQL - Local development
POSTGRES_USER=fincore_admin
POSTGRES_PASSWORD=local_admin_password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Identity Service
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=local_identity_password

# Core Banking Service
CORE_BANKING_DB_NAME=core_banking_db
CORE_BANKING_DB_USER=core_banking_user
CORE_BANKING_DB_PASSWORD=local_core_banking_password

# Payment Service
PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=local_payment_password
